rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário autenticado com e-mail institucional verificado
    function isInstitucional() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@educacao[.]mg[.]gov[.]br$');
    }

    function texto(d, campo, max) {
      return d[campo] is string && d[campo].size() <= max;
    }

    function dadosValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'cargo', 'secretaria', 'orgao', 'telefone',
                               'celular', 'endereco', 'email', 'atualizadoEm'])
        && texto(d, 'nome', 60) && d.nome.size() > 0
        && texto(d, 'cargo', 80)
        && d.secretaria == 'Secretaria de Estado de Educação (SEE/MG)'
        && texto(d, 'orgao', 100)
        && texto(d, 'telefone', 20)
        && texto(d, 'celular', 20)
        && texto(d, 'endereco', 100)
        && d.email == request.auth.token.email
        && d.atualizadoEm == request.time;
    }

    // Cada usuário só lê/grava a própria assinatura
    match /assinaturas/{uid} {
      allow read: if isInstitucional() && request.auth.uid == uid;
      allow create, update: if isInstitucional() && request.auth.uid == uid && dadosValidos();
      allow delete: if isInstitucional() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
